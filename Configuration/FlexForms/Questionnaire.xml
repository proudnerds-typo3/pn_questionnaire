<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:sheet.general</sheetTitle>
                <type>array</type>
                <el>
                    <settings.questionnaire>
                        <label>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.questionnaire</label>
                        <description>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.questionnaire.description</description>
                        <config>
                            <type>group</type>
                            <allowed>tx_pnquestionnaire_questionnaire</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>1</minitems>
                            <suggestOptions>
                                <default>
                                    <searchWholePhrase>true</searchWholePhrase>
                                    <searchCondition>tx_pnquestionnaire_questionnaire.hidden = 0</searchCondition>
                                    <orderBy>tx_pnquestionnaire_questionnaire.title ASC</orderBy>
                                </default>
                            </suggestOptions>
                        </config>
                    </settings.questionnaire>
                    <settings.introduction_screen>
                        <label>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.introduction_screen</label>
                        <description>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.introduction_screen.description</description>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </settings.introduction_screen>
                    <settings.show_score>
                        <label>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.show_score</label>
                        <description>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.show_score.description</description>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.show_score>
                    <settings.show_answer_summary>
                        <label>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.show_answer_summary</label>
                        <description>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.show_answer_summary.description</description>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.show_answer_summary>
                    <settings.statistics_enabled>
                        <label>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.statistics_enabled</label>
                        <description>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.statistics_enabled.description</description>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.statistics_enabled>
                </el>
            </ROOT>
        </sDEF>
        <sLabels>
            <ROOT>
                <sheetTitle>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:sheet.labels</sheetTitle>
                <sheetDescription>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:sheet.labels.description</sheetDescription>
                <type>array</type>
                <el>
                    <settings.button_start>
                        <label>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.button_start</label>
                        <config>
                            <type>input</type>
                            <eval>trim</eval>
                            <size>30</size>
                            <placeholder>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang.xlf:button.start</placeholder>
                        </config>
                    </settings.button_start>
                    <settings.button_previous>
                        <label>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.button_previous</label>
                        <config>
                            <type>input</type>
                            <eval>trim</eval>
                            <size>30</size>
                            <placeholder>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang.xlf:button.previous</placeholder>
                        </config>
                    </settings.button_previous>
                    <settings.button_next>
                        <label>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.button_next</label>
                        <config>
                            <type>input</type>
                            <eval>trim</eval>
                            <size>30</size>
                            <placeholder>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang.xlf:button.next</placeholder>
                        </config>
                    </settings.button_next>
                    <settings.button_finish>
                        <label>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.button_finish</label>
                        <config>
                            <type>input</type>
                            <eval>trim</eval>
                            <size>30</size>
                            <placeholder>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang.xlf:button.finish</placeholder>
                        </config>
                    </settings.button_finish>
                    <settings.button_reset>
                        <label>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.button_reset</label>
                        <config>
                            <type>input</type>
                            <eval>trim</eval>
                            <size>30</size>
                            <placeholder>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang.xlf:button.reset</placeholder>
                        </config>
                    </settings.button_reset>
                    <settings.button_change_answers>
                        <label>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.button_change_answers</label>
                        <config>
                            <type>input</type>
                            <eval>trim</eval>
                            <size>30</size>
                            <placeholder>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang.xlf:button.changeAnswers</placeholder>
                        </config>
                    </settings.button_change_answers>
                    <settings.button_copy_link>
                        <label>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.button_copy_link</label>
                        <displayCond>FIELD:sSavedResult.settings.db_save_result_enabled:=:1</displayCond>
                        <config>
                            <type>input</type>
                            <eval>trim</eval>
                            <size>30</size>
                            <placeholder>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang.xlf:savedResult.copy</placeholder>
                        </config>
                    </settings.button_copy_link>
                    <settings.button_mail_submit>
                        <label>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.button_mail_submit</label>
                        <displayCond>FIELD:sSavedResult.settings.mail_result_enabled:=:1</displayCond>
                        <config>
                            <type>input</type>
                            <eval>trim</eval>
                            <size>30</size>
                            <placeholder>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang.xlf:mail.submit</placeholder>
                        </config>
                    </settings.button_mail_submit>
                </el>
            </ROOT>
        </sLabels>
        <sSavedResult>
            <ROOT>
                <sheetTitle>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:sheet.savedResult</sheetTitle>
                <type>array</type>
                <el>
                    <settings.db_save_result_enabled>
                        <label>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.db_save_result_enabled</label>
                        <description>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.db_save_result_enabled.description</description>
                        <onChange>reload</onChange>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.db_save_result_enabled>
                    <settings.db_save_result_storage_pid>
                        <label>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.db_save_result_storage_pid</label>
                        <description>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.db_save_result_storage_pid.description</description>
                        <displayCond>FIELD:settings.db_save_result_enabled:=:1</displayCond>
                        <config>
                            <type>group</type>
                            <allowed>pages</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>1</minitems>
                        </config>
                    </settings.db_save_result_storage_pid>
                    <settings.db_save_result_lifetime_days>
                        <label>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.db_save_result_lifetime_days</label>
                        <description>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.db_save_result_lifetime_days.description</description>
                        <displayCond>FIELD:settings.db_save_result_enabled:=:1</displayCond>
                        <config>
                            <type>input</type>
                            <eval>trim,num</eval>
                            <size>6</size>
                        </config>
                    </settings.db_save_result_lifetime_days>
                    <settings.mail_result_enabled>
                        <label>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.mail_result_enabled</label>
                        <description>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.mail_result_enabled.description</description>
                        <displayCond>FIELD:settings.db_save_result_enabled:=:1</displayCond>
                        <onChange>reload</onChange>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.mail_result_enabled>
                    <settings.privacy_link>
                        <label>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.privacy_link</label>
                        <description>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.privacy_link.description</description>
                        <displayCond>FIELD:settings.db_save_result_enabled:=:1</displayCond>
                        <config>
                            <type>link</type>
                            <allowedTypes>page,url</allowedTypes>
                            <size>30</size>
                        </config>
                    </settings.privacy_link>
                    <settings.mail_from_address>
                        <label>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.mail_from_address</label>
                        <description>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.mail_from_address.description</description>
                        <displayCond>FIELD:settings.mail_result_enabled:=:1</displayCond>
                        <config>
                            <type>email</type>
                            <size>30</size>
                        </config>
                    </settings.mail_from_address>
                    <settings.mail_from_name>
                        <label>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.mail_from_name</label>
                        <description>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.mail_from_name.description</description>
                        <displayCond>FIELD:settings.mail_result_enabled:=:1</displayCond>
                        <config>
                            <type>input</type>
                            <eval>trim</eval>
                            <size>30</size>
                        </config>
                    </settings.mail_from_name>
                    <settings.mail_intro_text>
                        <label>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.mail_intro_text</label>
                        <description>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.mail_intro_text.description</description>
                        <displayCond>FIELD:settings.mail_result_enabled:=:1</displayCond>
                        <config>
                            <type>text</type>
                            <cols>48</cols>
                            <rows>5</rows>
                            <enableRichtext>1</enableRichtext>
                        </config>
                    </settings.mail_intro_text>
                    <settings.mail_footer_text>
                        <label>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.mail_footer_text</label>
                        <description>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.mail_footer_text.description</description>
                        <displayCond>FIELD:settings.mail_result_enabled:=:1</displayCond>
                        <config>
                            <type>text</type>
                            <cols>48</cols>
                            <rows>5</rows>
                            <enableRichtext>1</enableRichtext>
                        </config>
                    </settings.mail_footer_text>
                    <settings.mail_rate_limit_disabled>
                        <label>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.mail_rate_limit_disabled</label>
                        <description>LLL:EXT:pn_questionnaire/Resources/Private/Language/locallang_be.xlf:flexform.mail_rate_limit_disabled.description</description>
                        <displayCond>FIELD:settings.mail_result_enabled:=:1</displayCond>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>0</default>
                        </config>
                    </settings.mail_rate_limit_disabled>
                </el>
            </ROOT>
        </sSavedResult>
    </sheets>
</T3DataStructure>

